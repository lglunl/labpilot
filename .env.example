# 服务端口与监听地址
PORT=8080
HOST=127.0.0.1

# Ollama 地址（保持只监听本机，不对外暴露）
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# 推理参数：7B Q4 在核显上约 6.5 tok/s，num_predict 不宜过大
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=600
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_MS=150000

# 队列与缓存
MAX_QUEUE=3
CACHE_TTL_MS=600000

# 启动时预热模型（首次加载约 15~20s）
PREWARM=0
