# 服务端口与监听地址
PORT=8080
HOST=127.0.0.1

# 大模型：DeepSeek（OpenAI 兼容接口）。把 key 填到 .env，不要写进代码。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=800
LLM_TIMEOUT_MS=60000

# 扫码 agent 访问预约接口的鉴权密钥。公网暴露后必须设置。
# LAB_API_TOKEN=

# 打印二维码用的预约服务公网地址，不要以 / 结尾。quick tunnel 每次重启会变。
# PUBLIC_BASE_URL=https://xxx.trycloudflare.com

# 队列与缓存
MAX_QUEUE=3
CACHE_TTL_MS=600000
