# 跨平台换行统一：源码用 LF，Windows 脚本用 CRLF
* text=auto eol=lf

# Dockerfile 与容器内脚本必须是 LF，否则 build 可能报错
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
.env.example text eol=lf

# Windows 批处理 / PowerShell 必须是 CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# 二进制
*.exe binary
*.png binary
*.jpg binary
*.woff2 binary
